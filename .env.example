# Copy to .env (read by docker compose and the services). Never commit .env.
DATABASE_URL=postgresql+psycopg://travelswarm:travelswarm@localhost:5432/travelswarm
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# "crewai" calls Gemini on Vertex AI; "fake" returns a canned itinerary (no cloud needed).
PLANNER=fake

# Vertex AI (only for PLANNER=crewai). Authenticate with
# `gcloud auth application-default login` or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

MAX_ATTEMPTS=3
